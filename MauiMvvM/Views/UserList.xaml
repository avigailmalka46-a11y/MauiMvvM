<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MauiMvvM.Models"
              xmlns:vm="clr-namespace:MauiMvvM.ViewModels"
    x:DataType="vm:UserListViewModel"

    x:Class="MauiMvvM.Views.UserList"
             Title="UserList">

   
    
    <VerticalStackLayout>
        <Label
        Text=" User List"
        FontSize="Medium"
        VerticalOptions="Center"
        HorizontalOptions="Center" />

        <Picker Title="choose person"
            ItemsSource="{Binding Users}"
            ItemDisplayBinding="{Binding Name}"
            SelectedItem="{Binding User}"
            ></Picker>

        <Label
    Text="{Binding DisplayUser}"
    VerticalOptions="Center"
    HorizontalOptions="Center" />

        <CollectionView ItemsSource="{Binding Users}" SelectionMode="Single">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:User">
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="delete" BackgroundColor="Red"
                                       Command="{Binding x:DataType='vm:UserListViewModel', Source={RelativeSource AncestorType={x:Type vm:UserListViewModel}}, Path=DeleteUserCommand}"
                                       CommandParameter="{Binding .}">
                                </SwipeItem>
                            </SwipeItems>
                        </SwipeView.RightItems>
                        <Border BackgroundColor="Aqua" StrokeThickness="1">
                            <Grid ColumnDefinitions="*,*,*">
                                <Label Text="{Binding Name}" TextColor="Green" FontSize="Medium"/>
                                <Label Grid.Column="1" Text="{Binding Password}" TextColor="Blue" FontSize="Medium"/>
                                <Button Grid.Column="2" Text="Show Details" TextColor="Green" FontSize="Medium"
                                    Command="{Binding x:DataType='vm:UserListViewModel', Source={RelativeSource AncestorType={x:Type vm:UserListViewModel}}, Path=ShowUserCommand}"
                                    CommandParameter="{Binding .}">
                                </Button>
                            </Grid>
                        </Border>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label
    Text="{Binding DisplayUser2}"
    VerticalOptions="Center"
    HorizontalOptions="Center" />
    </VerticalStackLayout>
 </ContentPage>