<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:views="clr-namespace:MauiMvvM.Views"
              xmlns:vm="clr-namespace:MauiMvvM.ViewModels"
            x:DataType="vm:LoginPageViewModel"
             x:Class="MauiMvvM.Views.AddUserPage1"
             
             Title="AdUserPage1">
    <VerticalStackLayout>
        <Label 
         Text="Add user"
         FontSize="Large"         VerticalOptions="Center" 
         HorizontalOptions="Center" />

        <Border
         MaximumWidthRequest="200"
         MaximumHeightRequest="100"
         StrokeThickness="2">

            <Entry
             
             Placeholder="Name"
           
             Text="{Binding Name}"
             VerticalOptions="Center"
             HorizontalOptions="Center"/>
        </Border>

        <Border
    MaximumWidthRequest="200"
    MaximumHeightRequest="100"
    StrokeThickness="2">

            <Entry
        
        Placeholder="Password"
     
        Text="{Binding Password}"
        VerticalOptions="Center"
        HorizontalOptions="Center"/>
        </Border>

        <Button WidthRequest="100"
             HeightRequest="50"
        Command="{Binding AddUserCommand}"
             Text="send">
           

        </Button>
        <Label
         FontSize="Large"
         TextColor="{Binding MessageColor}"
          IsVisible="{Binding MessageVisible}"
         Text="{Binding MessageError}"
         VerticalOptions="Center"    
         HorizontalOptions="Center">

        </Label>


    </VerticalStackLayout>
</ContentPage>