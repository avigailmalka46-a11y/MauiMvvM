<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MauiMvvM.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:MauiMvvM.Views"
    xmlns:local="clr-namespace:MauiMvvM"
    
    Title="MauiMvvM">
    
    <Shell.FlyoutHeader>
        <StackLayout
        BackgroundColor="DarkGreen"
        Padding="20"
        VerticalOptions="Center">
            <Label FontAttributes="Bold" FontSize="Header" Text="Welcome" />
        </StackLayout>
    </Shell.FlyoutHeader>

    <Shell.FlyoutFooter>
        <StackLayout
        BackgroundColor="Red"
        Padding="20"
        VerticalOptions="Center">
        </StackLayout>
    </Shell.FlyoutFooter>
    
    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate views:UserList}"
        Icon="bird.png"
       Route="LoginPage" />

    <FlyoutItem Title="more" Icon="cat.png">
        <ShellContent
        Title="List"
        ContentTemplate="{DataTemplate views:ListUserPage}"
        Icon="dotnet_bot.png"
        Route="ListPage" />

        <ShellContent
        Title="Add"
        ContentTemplate="{DataTemplate views:AddUserPage}"
        Icon="tea.png"
        Route="AddPage" />
    </FlyoutItem>
    

</Shell>
